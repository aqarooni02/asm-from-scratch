# Lesson binaries have no file extension, so ignore all extensionless
# files, then re-include the sources / docs / build files we track.
# (If you ever add another extensionless helper, add a "!name" line.)
*
!*/
!*.*
!Makefile*
!.gitignore

# Object files and default linker output (have extensions, so re-ignore)
*.o
a.out
